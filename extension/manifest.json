{
  "name": "公式渲染助手 (Formula Render Assistant)",
  "short_name": "渲染助手",
  "description": "选中网页中的 LaTeX/Markdown 公式代码，点击「渲染」即可原地变成可读公式。离线可用，支持电脑与手机/平板（Chromium 内核浏览器）。",
  "version": "1.0.2",
  "minimum_chrome_version": "95",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "公式渲染助手",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/katex.min.js", "core.js", "content.js"],
      "css": ["assets/katex.min.css", "selection-ui.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*", "assets/katex.min.css", "selection-ui.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["clipboardWrite", "scripting", "activeTab"]
}
